# Token bot lấy từ @BotFather trên Telegram
TELEGRAM_BOT_TOKEN=

# Điền ít nhất một trong hai key dưới đây
# Claude: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
# Gemini: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Model mặc định khi bắt đầu chat: claude hoặc gemini
DEFAULT_PROVIDER=claude

# Tuỳ chọn
CLAUDE_MODEL=claude-opus-5-5
CLAUDE_EFFORT=low
GEMINI_MODEL=gemini-2.5-flash
MAX_HISTORY=20
# Danh sách user ID Telegram được phép dùng (cách nhau dấu phẩy). Để trống = ai cũng dùng được.
ALLOWED_USER_IDS=
