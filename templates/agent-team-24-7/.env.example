# Chat
TELEGRAM_BOT_TOKEN=
ALLOWED_USER_IDS=123456789          # danh sách user id, phân tách bằng dấu phẩy

# LLM (chọn provider bạn dùng)
LLM_PROVIDER=anthropic              # anthropic | openai | google | ollama
LLM_API_KEY=
MODEL_STRONG=                       # planner, reviewer
MODEL_FAST=                         # worker việc lặp lại

# Hạ tầng
DATABASE_URL=postgresql://agent:agent@postgres:5432/agentteam
REDIS_URL=redis://redis:6379/0

# Chốt chặn
DAILY_BUDGET_USD=10
HEARTBEAT_MINUTES=15
MAX_TASK_ATTEMPTS=3

# Observability (tuỳ chọn)
LANGFUSE_HOST=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
