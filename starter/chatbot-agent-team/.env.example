# Sao chép file này thành .env rồi điền giá trị:  cp .env.example .env

# --- Bắt buộc khi chạy thật: lấy tại https://console.anthropic.com -> API Keys ---
ANTHROPIC_API_KEY=

# 1 = chạy giả lập, không gọi API, không tốn tiền (dùng để thử cài đặt). Đổi thành 0 khi đã có API key.
FAKE_LLM=1

# --- Model theo vai trò (có thể để nguyên) ---
MODEL_ROUTER=claude-haiku-5-5
MODEL_AGENT=claude-sonnet-5-5
MODEL_ORCHESTRATOR=claude-opus-5-5

# Research agent tìm kiếm web. Đặt 0 nếu tổ chức của bạn chưa bật Web search trong Console.
ENABLE_WEB_SEARCH=1

# Tên trợ lý hiển thị trong câu trả lời
BOT_NAME=Trợ lý ABC

# --- Tùy chọn ---
# Token bot Telegram (lấy từ @BotFather) — bước 6 trong hướng dẫn
TELEGRAM_BOT_TOKEN=
# Webhook n8n nhận hành động đã được duyệt — bước 7 trong hướng dẫn
# Chạy n8n bằng docker compose thì dùng: http://n8n:5678/webhook/agent-action
N8N_WEBHOOK_URL=

DB_PATH=data/app.db
WORKER_POLL_SECONDS=2
MAX_REVIEW_ROUNDS=2
