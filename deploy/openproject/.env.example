# Sao chép thành .env rồi sửa:  cp .env.example .env
# Tạo chuỗi bí mật:              openssl rand -hex 32

# Phiên bản OpenProject (tag Docker). Cập nhật: đổi số này rồi chạy ./op.sh update
TAG=17
HOCUSPOCUS_TAG=17.8.3

# Địa chỉ người dùng truy cập (kèm cổng nếu không phải 80/443)
OPENPROJECT_HOST__NAME=localhost:8080
OPENPROJECT_HTTPS=false
COLLABORATIVE_SERVER_URL=ws://localhost:8080/hocuspocus
OPENPROJECT_DEFAULT__LANGUAGE=vi

# Caddy: ":80" = HTTP. Đặt tên miền (vd pm.congty.vn) để tự bật HTTPS,
# khi đó đổi HTTP_PORT=80, HTTPS_PORT=443, OPENPROJECT_HTTPS=true,
# OPENPROJECT_HOST__NAME=pm.congty.vn, COLLABORATIVE_SERVER_URL=wss://pm.congty.vn/hocuspocus
SITE_ADDRESS=:80
HTTP_PORT=8080
HTTPS_PORT=8443

# Bắt buộc đổi
SECRET_KEY_BASE=DOI_TOI
POSTGRES_PASSWORD=DOI_TOI
COLLABORATIVE_SERVER_SECRET=DOI_TOI
