# Sao chép file này thành .env rồi điền giá trị. KHÔNG commit file .env lên git.

# --- ERP (Frappe/ERPNext) ---
# Dùng site TEST trước khi chạy trên erp.eup.vn
ERP_URL=https://erp-test.eup.vn
ERP_API_KEY=
ERP_API_SECRET=

# true = chỉ đọc ERP; lệnh ghi và tin nhắn chỉ in ra màn hình. Giữ true cho tới khi chạy thử xong.
DRY_RUN=true

# --- Claude API ---
ANTHROPIC_API_KEY=
LLM_ENABLED=true
LLM_MODEL=claude-opus-5-5
LLM_EFFORT=medium

# --- Gửi tin ---
# console (in màn hình) | erp_bell (chuông thông báo trong ERP) | webhook (gửi sang n8n → email/chat)
NOTIFY_BACKEND=erp_bell
NOTIFY_WEBHOOK_URL=

# Mật khẩu để n8n gọi dịch vụ agent (tự đặt chuỗi ngẫu nhiên dài)
SERVICE_TOKEN=

TZ_NAME=Asia/Ho_Chi_Minh
ORG_FILE=config/org.json
REPORT_DIR=reports
