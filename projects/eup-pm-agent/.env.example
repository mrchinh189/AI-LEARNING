# Sao chép file này thành .env rồi điền giá trị. KHÔNG commit file .env.

# --- ERP EuP ---
# Bắt đầu bằng site UAT. Chỉ đổi sang PROD sau khi đã qua Bước 9 của hướng dẫn.
ERP_URL=https://uat.erp.eup.vn
ERP_API_KEY=
ERP_API_SECRET=

# 1 = chỉ in ra những gì sẽ ghi, không ghi gì lên ERP. Đổi thành 0 khi đã kiểm tra kỹ.
DRY_RUN=1

# --- Claude API (chỉ cần cho lệnh `report`) ---
ANTHROPIC_API_KEY=
# Mã model Claude dùng để viết phần nhận định trong báo cáo (xem hướng dẫn, Bước 7).
EUP_AGENT_MODEL=
# Tuỳ chọn: model riêng cho từng agent (orchestrator, planner, tracker, risk), VD dùng model rẻ hơn
# cho Agent Thu thập vì việc của nó đơn giản và chạy nhiều lần. Bỏ trống = dùng EUP_AGENT_MODEL.
EUP_AGENT_MODEL_TRACKER=
# Fallback cho model riêng (mặc định off; chỉ bật default nếu model đó hỗ trợ).
EUP_AGENT_FALLBACKS_TRACKER=off
# low | medium | high (dùng cho lệnh report; effort của từng agent đặt trong config/rules.yaml)
EUP_AGENT_EFFORT=medium
# default = khi model chính từ chối, API tự chạy lại bằng model dự phòng. off = tắt.
EUP_AGENT_FALLBACKS=default

# --- Khác ---
RULES_FILE=config/rules.yaml
LOG_DIR=logs

# --- Webhook cho đội agent (lệnh serve, Giai đoạn 3) ---
# Chuỗi ngẫu nhiên ≥ 24 ký tự. Tạo bằng: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
EUP_WEBHOOK_TOKEN=
