# Sao chép file này thành .env rồi điền giá trị. KHÔNG commit file .env.

# --- ERP EuP ---
# Bắt đầu bằng site UAT. Chỉ đổi sang PROD sau khi đã qua Bước 9 của hướng dẫn.
ERP_URL=https://uat.erp.eup.vn
ERP_API_KEY=
ERP_API_SECRET=

# 1 = chỉ in ra những gì sẽ ghi, không ghi gì lên ERP. Đổi thành 0 khi đã kiểm tra kỹ.
DRY_RUN=1

# --- Claude API (chỉ cần cho lệnh `report`) ---
ANTHROPIC_API_KEY=
# Mã model Claude dùng để viết phần nhận định trong báo cáo (xem hướng dẫn, Bước 7).
EUP_AGENT_MODEL=
# low | medium | high
EUP_AGENT_EFFORT=medium
# default = khi model chính từ chối, API tự chạy lại bằng model dự phòng. off = tắt.
EUP_AGENT_FALLBACKS=default

# --- Khác ---
RULES_FILE=config/rules.yaml
LOG_DIR=logs
